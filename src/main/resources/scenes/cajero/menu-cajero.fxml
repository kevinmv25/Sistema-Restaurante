<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.sistema.controllers.cajero.MenuCajeroController">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <top>
                <HBox style="-fx-background-color:#2c2e33;">
                    <children>
                        <Label text="Módulo de Cajero"
                               style="-fx-text-fill:white; -fx-font-size:26px; -fx-font-weight:bold;">
                            <HBox.margin>
                                <Insets top="25.0" bottom="25.0" left="25.0"/>
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </top>

            <center>
                <GridPane hgap="25.0" vgap="25.0" alignment="CENTER">

                    <Button text="Generar cuenta / factura"
                            prefWidth="260.0"
                            prefHeight="60.0"
                            onAction="#irFacturacion"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <Button text="Registrar pago"
                            prefWidth="260.0"
                            prefHeight="60.0"
                            onAction="#irPagos"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>

                    <Button text="Gestión de caja"
                            prefWidth="260.0"
                            prefHeight="60.0"
                            onAction="#irCaja"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                    <Button text="Aplicar descuentos"
                            prefWidth="260.0"
                            prefHeight="60.0"
                            onAction="#irDescuentos"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                    <Button text="Cancelar pago / reembolso"
                            prefWidth="260.0"
                            prefHeight="60.0"
                            onAction="#irReembolsos"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"/>

                    <Button text="Cerrar sesión"
                            prefWidth="260.0"
                            prefHeight="60.0"
                            onAction="#cerrarSesion"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>
                    <Button text="Historial de ventas"
                            prefWidth="260.0"
                            prefHeight="60.0"
                            onAction="#irHistorialVentas"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                </GridPane>
            </center>

        </BorderPane>
    </children>
</AnchorPane>