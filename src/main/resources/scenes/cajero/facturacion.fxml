<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.sistema.controllers.cajero.FacturacionController">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <top>
                <HBox style="-fx-background-color:#2c3e50;" BorderPane.alignment="CENTER">
                    <children>
                        <Label text="Generar Cuenta y Factura"
                               style="-fx-text-fill:white; -fx-font-size:24px;">
                            <HBox.margin>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </top>

            <center>
                <VBox spacing="15.0" style="-fx-padding: 20;" BorderPane.alignment="CENTER">
                    <children>
                        <TableView prefHeight="250.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn prefWidth="250.0" text="Producto"/>
                                <TableColumn prefWidth="100.0" text="Cantidad"/>
                                <TableColumn prefWidth="150.0" text="Precio"/>
                            </columns>
                        </TableView>

                        <HBox spacing="20.0">
                            <children>
                                <ComboBox promptText="Tipo Documento" prefWidth="150.0"/>
                                <ComboBox promptText="Formato" prefWidth="150.0"/>
                            </children>
                        </HBox>

                        <HBox spacing="20.0">
                            <children>
                                <RadioButton text="Incluir IVA">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="grupoImpuestos" />
                                    </toggleGroup>
                                </RadioButton>
                                <RadioButton text="Desglosar IVA" toggleGroup="$grupoImpuestos"/>
                            </children>
                        </HBox>

                        <TextArea prefHeight="150.0" promptText="Vista previa del documento"/>

                        <Button prefWidth="200.0" text="Generar Documento" />
                    </children>
                </VBox>
            </center>

        </BorderPane>
    </children>
</AnchorPane>