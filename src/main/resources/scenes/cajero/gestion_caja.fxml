<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.sistema.controllers.cajero.CajaController">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <top>
                <HBox spacing="20.0" style="-fx-background-color:#1f618d;" alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="btnVolverMenu"
                                text="Volver al menú"
                                onAction="#volverMenuCajero"
                                style="-fx-background-color:#34363a; -fx-text-fill:white;">
                            <HBox.margin>
                                <Insets left="15.0"/>
                            </HBox.margin>
                        </Button>

                        <Label text="Gestión de Caja"
                               style="-fx-text-fill:white; -fx-font-size:24px;">
                            <HBox.margin>
                                <Insets top="20.0" bottom="20.0"/>
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </top>

            <center>
                <GridPane hgap="20.0" vgap="20.0" style="-fx-padding:30;">

                    <Label text="Monto Inicial:" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtMontoInicial"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                    <Label text="Total Esperado:" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtTotalEsperado"
                               editable="false"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1"/>

                    <Label text="Conteo Físico:" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtConteoFisico"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2"/>

                    <Label text="Justificación:" GridPane.rowIndex="3"/>
                    <TextArea fx:id="txtJustificacion"
                              prefHeight="120.0"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="3"/>

                    <HBox spacing="20.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4">

                        <Button fx:id="btnAbrirCaja"
                                text="Abrir Caja"
                                onAction="#handleAbrirCaja"/>

                        <Button fx:id="btnCerrarCaja"
                                text="Cerrar Caja"
                                onAction="#handleCerrarCaja"/>

                    </HBox>

                </GridPane>
            </center>

        </BorderPane>
    </children>
</AnchorPane>