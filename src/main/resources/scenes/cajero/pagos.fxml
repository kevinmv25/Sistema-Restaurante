<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.sistema.controllers.cajero.PagosController">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <top>
                <HBox spacing="20.0" style="-fx-background-color:#34495e;" alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="btnVolverMenu"
                                text="Volver al menú"
                                onAction="#volverMenuCajero"
                                style="-fx-background-color:#34363a; -fx-text-fill:white;">
                            <HBox.margin>
                                <Insets left="15.0"/>
                            </HBox.margin>
                        </Button>

                        <Label text="Registro de Pago"
                               style="-fx-text-fill:white; -fx-font-size:24px;">
                            <HBox.margin>
                                <Insets top="20.0" bottom="20.0"/>
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </top>

            <center>
                <VBox spacing="18.0" style="-fx-padding:25;">

                    <Label text="Cuentas pendientes de pago"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <TableView fx:id="tablaCuentasPendientes" prefHeight="280.0">
                        <columns>
                            <TableColumn fx:id="colCuenta" text="Cuenta" prefWidth="100.0"/>
                            <TableColumn fx:id="colPedido" text="Pedido" prefWidth="100.0"/>
                            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="130.0"/>
                            <TableColumn fx:id="colImpuestos" text="Impuestos" prefWidth="130.0"/>
                            <TableColumn fx:id="colDescuento" text="Descuento" prefWidth="130.0"/>
                            <TableColumn fx:id="colTotal" text="Total" prefWidth="130.0"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="130.0"/>
                        </columns>
                    </TableView>

                    <GridPane hgap="15.0" vgap="15.0">

                        <Label text="Saldo Pendiente:" GridPane.rowIndex="0"/>
                        <TextField fx:id="txtSaldoPendiente"
                                   editable="false"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="0"/>

                        <Label text="Método de Pago:" GridPane.rowIndex="1"/>
                        <ComboBox fx:id="comboMetodoPago"
                                  GridPane.columnIndex="1"
                                  GridPane.rowIndex="1"
                                  promptText="Seleccionar"
                                  prefWidth="200.0"/>

                        <Label text="Monto Recibido:" GridPane.rowIndex="2"/>
                        <TextField fx:id="txtMonto"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2"/>

                        <Button fx:id="btnProcesarPago"
                                text="Procesar Pago"
                                onAction="#handleProcesarPago"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="3"/>

                    </GridPane>

                </VBox>
            </center>

        </BorderPane>
    </children>
</AnchorPane>