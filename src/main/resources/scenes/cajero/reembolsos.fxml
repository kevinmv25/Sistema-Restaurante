<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.sistema.controllers.cajero.ReembolsosController">
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <HBox style="-fx-background-color:#922b21;" BorderPane.alignment="CENTER">
                    <children>
                        <Label style="-fx-text-fill:white; -fx-font-size:24px;" text="Cancelar Pago y Reembolso">
                            <HBox.margin>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </top>
            <center>
                <GridPane hgap="20.0" style="-fx-padding: 20;" vgap="20.0" BorderPane.alignment="CENTER">
                    <Label text="Buscar Ticket:" />
                    <TextField fx:id="txtBuscar" GridPane.columnIndex="1" />
                    <Button fx:id="btnBuscar" onAction="#handleBuscarTicket" text="Buscar" GridPane.columnIndex="2" />
                    
                    <TableView fx:id="tablaOrdenes" prefHeight="250.0" GridPane.columnSpan="3" GridPane.rowIndex="1">
                        <columns>
                            <TableColumn fx:id="colOrden" prefWidth="150.0" text="Orden" />
                            <TableColumn fx:id="colMonto" prefWidth="100.0" text="Monto" />
                            <TableColumn fx:id="colMetodo" prefWidth="150.0" text="Método" />
                        </columns>
                    </TableView>
                    
                    <Label text="Motivo Cancelación:" GridPane.rowIndex="2" />
                    <TextArea fx:id="txtMotivo" prefHeight="120.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    
                    <Button fx:id="btnCancelar" onAction="#handleCancelarPago" text="Cancelar Pago" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </GridPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
