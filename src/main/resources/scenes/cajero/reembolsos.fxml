<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.sistema.controllers.cajero.ReembolsosController">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <top>
                <HBox spacing="20.0" style="-fx-background-color:#922b21;" alignment="CENTER_LEFT">
                    <children>
                        <Button text="Volver al menú"
                                onAction="#volverMenuCajero"
                                style="-fx-background-color:#34363a; -fx-text-fill:white;">
                            <HBox.margin>
                                <Insets left="15.0"/>
                            </HBox.margin>
                        </Button>

                        <Label text="Cancelar Pago y Reembolso"
                               style="-fx-text-fill:white; -fx-font-size:24px;">
                            <HBox.margin>
                                <Insets top="20.0" bottom="20.0"/>
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </top>

            <center>
                <VBox spacing="18.0" style="-fx-padding:25;">

                    <Label text="Pagos del turno actual"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <HBox spacing="10.0">
                        <TextField fx:id="txtBuscar"
                                   promptText="Buscar por ID de pago"
                                   prefWidth="220.0"/>

                        <Button text="Buscar"
                                onAction="#handleBuscarTicket"/>
                    </HBox>

                    <TableView fx:id="tablaPagos" prefHeight="280.0">
                        <columns>
                            <TableColumn fx:id="colPago" text="Pago" prefWidth="100.0"/>
                            <TableColumn fx:id="colCuenta" text="Cuenta" prefWidth="100.0"/>
                            <TableColumn fx:id="colMetodo" text="Método" prefWidth="150.0"/>
                            <TableColumn fx:id="colMonto" text="Monto" prefWidth="130.0"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="130.0"/>
                            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="220.0"/>
                        </columns>
                    </TableView>

                    <Label text="Motivo de cancelación:"/>

                    <TextArea fx:id="txtMotivo"
                              prefHeight="100.0"
                              promptText="Ingresa la justificación"/>

                    <Button text="Cancelar Pago"
                            onAction="#handleCancelarPago"
                            prefWidth="180.0"/>

                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>